/* What System Profiler puts together while it is running. The four sections themselves
   are in the window's own table, because they are in the window. */

/* One fact: what it is called, then what it is. */
"profiler.line" = "%1$@:  %2$@";

/* Software. */
"profiler.systemVersion" = "System Version";
"profiler.systemName" = "System Name";
"profiler.built" = "Built";
"profiler.computerName" = "Computer Name";

/* Volumes. A volume that is not ready is an optical drive with nothing in it. */
"profiler.volumeSizes" = "%1$@, %2$@ free";
"profiler.notReady" = "not ready";

/* Locations. */
"profiler.systemVolume" = "System Volume";
"profiler.preferences" = "Preferences";
"profiler.iconResources" = "Icon Resources";
"profiler.applications" = "Applications";

/* Hardware, which is what it shows when nothing has been picked. */
"profiler.processor" = "Processor";
"profiler.memory" = "Memory";
"profiler.startupDisk" = "Startup Disk";
