"detected.spoken" = "%1$@: %2$@";
"detected.link" = "Link";
"detected.openLink" = "Open Link";
"detected.mail" = "Email address";
"detected.newMessage" = "New Message";
"detected.phone" = "Telephone number";
"detected.copyNumber" = "Copy Number";
"detected.date" = "Date";
"detected.showDate" = "Show Date";
"detected.address" = "Address";
"detected.showMap" = "Show Map";

/* The spelling panel, which belongs to the system rather than to any program: every
