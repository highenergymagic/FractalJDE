"spelling.noDictionary" = "No spelling dictionary is installed for any language this system asked for.";

/* The desktop itself: the two strips at the edges of the screen, the background behind
   everything, and what the status line says when windows are hidden and shown. */
"desktop.menuBar" = "Menu bar";
"desktop.dock" = "Dock";
"desktop.background" = "Desktop background";
"desktop.allHidden" = "All windows hidden";
"desktop.othersHidden" = "Other windows hidden";
"desktop.allShown" = "All windows shown";

/* The menu named for whichever program is in front, which cannot be in the bar's own
