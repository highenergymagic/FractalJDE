"spelling.title" = "Spelling and Grammar";
"spelling.wordLabel" = "Word:";
"spelling.word" = "Word";
"spelling.suggestions" = "Suggestions";
"spelling.ignore" = "Ignore";
"spelling.learn" = "Learn";
"spelling.findNext" = "Find Next";
